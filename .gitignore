# Owner-supplied credentials for the opt-in live connector acceptance scripts.
# These are never committed and never packaged.
scripts/acceptance/*.local.json

# Windows shortcuts embed the absolute path of the machine that made them, plus
# its host name. One was committed by accident and had to be scrubbed.
*.lnk
