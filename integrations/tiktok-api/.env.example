# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
API_KEY=
PORT=8787
# The service defaults to dry runs. Set true only when ready for real writes.
ENABLE_TIKTOK_WRITES=false
# Optional: only needed when a request explicitly selects provider=official.
TIKTOK_ACCESS_TOKEN=
# All browser actions use the separate profile created by npm run login.
TIKTOK_PROFILE_DIR=.runtime/tiktok-profile
TIKTOK_EXPECTED_USERNAME=jamftest
# Browser posting only reads video files beneath this directory.
TIKTOK_MEDIA_DIR=.runtime/media
# Session instruction: outgoing messages are restricted to this user.
TIKTOK_MESSAGE_RECIPIENT=user602phx
# Pin the ID shown for user602phx by GET /v1/conversations. Required for sends.
TIKTOK_MESSAGE_CONVERSATION_ID=
